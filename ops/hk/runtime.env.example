# This is documentation only; bootstrap generates private runtime.env on the host.
APP_ENV=production
DATABASE_SCHEMA=insong
MIGRATION_READ_ONLY=0
DATABASE_URL=postgresql://insong_app:replace-on-host@postgres:5432/insong?sslmode=verify-full
DATABASE_SSLROOTCERT=/run/insong-ca/ca.crt
CORS_ORIGINS=https://insong.me,https://insong.vercel.app
