{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm test && corepack pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "insong.vercel.app"}],
      "destination": "https://insong.me/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/fonts/chunks/:path*",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://insong.me/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
