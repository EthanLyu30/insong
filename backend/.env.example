# Local development defaults to SQLite. Production requires PostgreSQL.
APP_ENV=development
DATABASE_URL=
DATABASE_SCHEMA=insong
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Render uses the bundled Supabase CA: /app/certs/prod-ca-2021.crt
# Other hosts may use their own verified server CA or system store.
DATABASE_SSLROOTCERT=system
